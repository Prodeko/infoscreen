# Read by the proxy in vite.config.ts on the machine running `vite` or
# `vite preview`. None of these end up in the page.

# Kiltiskamera's on-air endpoint. The value is in the Azure environment
# values of the kiltiskamera app.
KILTISKAMERA_ON_AIR_PASSWORD=replace_with_real_password

# Digitransit subscription key for the HSL departures.
HSL_SUBSCRIPTION_KEY=replace_with_real_hsl_key

# Optional. Free key from twelvedata.com for the Stocks slide.
TWELVE_DATA_API_KEY=

# Optional. Where the slides come from; defaults to https://prodeko.org.
# For local testing, run `hugo server` in Prodeko/prodeko-org and use:
# SLIDES_ORIGIN=http://localhost:1313

# Optional. Where the PTER ideas come from; defaults to https://pter.prodeko.org.
# PTER_ORIGIN=http://localhost:3000
