# Stage 1: Build the React app
FROM node:22 AS build

WORKDIR /app

# Copy package.json and package-lock.json to install dependencies
COPY package*.json ./

# Install dependencies
RUN npm install

# Copy the rest of your application's code to the container
COPY . .

# Build the React app
RUN npm run build

# Stage 2: Set up the production environment
FROM node:22

# Install nginx and cron
RUN apt-get update && apt-get install -y nginx cron

# Copy nginx config
COPY nginx.prod.conf /etc/nginx/nginx.conf

# Remove default nginx site config if necessary
RUN rm /etc/nginx/sites-enabled/default

# Copy built React app from Stage 1
COPY --from=build /app/dist /usr/share/nginx/html

# Create directory for data
RUN mkdir -p /app/data

# Copy the scrape script and package files
COPY scrapePlaywright.js /app/scrapePlaywright.js
COPY package*.json /app/

# Set the working directory
WORKDIR /app

# Install dependencies for the scrape script
RUN npm install

# Install Playwright browsers
RUN npx playwright install --with-deps

# Set up cron job
COPY crontab /etc/cron.d/scrape-cron
RUN chmod 0644 /etc/cron.d/scrape-cron
RUN crontab /etc/cron.d/scrape-cron

# Copy entrypoint script
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose port 80
EXPOSE 80

# Set environment variables
ENV EVENT_FILE_PATH=/app/data/events.json

# Start the entrypoint script
ENTRYPOINT ["/entrypoint.sh"]
